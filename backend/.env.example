# ==========================================================
# Finora Backend - Local Environment
# ==========================================================
#
# Copy:
#
#   cp backend/.env.example backend/.env
#
# IMPORTANT:
#
#   This file contains local development credentials/config.
#   The actual backend/.env MUST NOT be committed.
#
# Database remains cloud hosted.
# ==========================================================


# ==========================================================
# Application
# ==========================================================

APP_NAME=Finora

DEBUG=true


# ==========================================================
# Database
# ==========================================================

# Local development still uses PostgreSQL.
# The PostgreSQL server itself is hosted by Neon.

DB_TYPE=postgresql

POSTGRES_USER=<neon-user>

POSTGRES_PASSWORD=<neon-password>

POSTGRES_HOST=<neon-host>

POSTGRES_PORT=5432

POSTGRES_DB=<neon-database>


# ==========================================================
# Security
# ==========================================================

# Local-development-only JWT signing key.
#
# Generate a strong random value for your actual backend/.env.
#
SECRET_KEY=<local-development-secret>

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60


# ==========================================================
# CORS
# ==========================================================

# Browser frontend served by local Nginx.
#
# The browser origin is localhost:80.
#
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:80"]